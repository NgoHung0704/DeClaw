# DeClaw Core
DECLAW_HOST=127.0.0.1
DECLAW_PORT=7842
DECLAW_DEBUG=false
DECLAW_LANGUAGE=en  # or "fr"
DECLAW_LOG_LEVEL=INFO  # TRACE | DEBUG | INFO | WARNING | ERROR | CRITICAL

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
# Brain: qwen2.5:3b (~2GB, fits 100% GPU on 4GB VRAM, EN+FR tool calling).
# Heavier alternatives if you have more VRAM: qwen2.5:7b, llama3.1:8b.
DECLAW_MODEL=qwen2.5:3b
# Sanitizer: deliberately BIGGER than the brain (~4.7GB). Measured on the
# 127-sample corpus: 3b = 7.5-9% false positives (it blocks ordinary client
# documents containing a password or an IBAN), 7b = 0.0% at the same detection.
# Cost: ~4.2s vs ~1.1s per screened file read. Set this to qwen2.5:3b to trade
# accuracy back for speed on constrained hardware.
DECLAW_SANITIZER_MODEL=qwen2.5:7b
DECLAW_EMBEDDING_MODEL=nomic-embed-text

# Paths
DECLAW_DATA_DIR=~/.declaw
DECLAW_WORKSPACE_DIR=~/DeClaw-workspace

# Security
DECLAW_REQUIRE_DOCKER_SANDBOX=true
DECLAW_SANITIZER_REQUIRED=true
DECLAW_PLUGIN_SIGNATURE_REQUIRED=true

# Network egress monitor
DECLAW_BLOCK_EXTERNAL_NETWORK=true
